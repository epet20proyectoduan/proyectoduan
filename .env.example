# Railway inyecta DATABASE_URL automáticamente al vincular el servicio PostgreSQL:
#   Variables → New Variable → Add Reference → Postgres → DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domuyo

# Clave que el ESP32 envía en el header X-API-Key (generar una larga y aleatoria)
API_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Railway define PORT automáticamente
PORT=3000
